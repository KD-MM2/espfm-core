# Nanopb options for espfm.proto
# Limits string/array sizes for static allocation

FanInfo.name              max_size:16
SourceInfo.name           max_size:16
CurveInfo.name            max_size:16
CurveInfo.points          max_count:10
WifiApRecord.ssid         max_size:33
SystemInfo.version        max_size:12
WifiStatus.sta_ip         max_size:16
WifiStatus.ap_ip          max_size:16

FanCreateRequest.name             max_size:16
FanUpdateRequest.name             max_size:16
SourceCreateRequest.name          max_size:16
CurveCreateRequest.name           max_size:16
CurveCreateRequest.points         max_count:10
CurveUpdateRequest.name           max_size:16
CurveUpdateRequest.points         max_count:10
WifiConnectRequest.ssid           max_size:33
WifiConnectRequest.password       max_size:64

StatusResponse.error_msg          max_size:64
