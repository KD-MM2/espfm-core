# Strings: fixed-size char arrays, no callbacks
FanInfo.name              max_size:16
SourceInfo.name           max_size:16
CurveInfo.name            max_size:16
FanCreateRequest.name     max_size:16
SourceCreateRequest.name  max_size:16
CurveCreateRequest.name   max_size:16
CurveUpdateRequest.name   max_size:16

# Repeated message fields: capped inline arrays
FanList.fans              max_count:8
SourceList.sources        max_count:8
CurveInfo.points          max_count:10
CurveList.curves          max_count:16
ScheduleList.schedules    max_count:8
WifiScanResult.aps        max_count:16
