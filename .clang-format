# espfm-core clang-format configuration
# Matches the existing project code style (ESP-IDF C, 4-space indent, K&R with function Allman)
BasedOnStyle: LLVM

# --- Layout ---
ColumnLimit: 100
UseTab: Never
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
SortIncludes: false
AlignTrailingComments: true

# --- Braces ---
# Function defs: brace on next line (Allman)
# Control statements: brace on same line (K&R)
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: true
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false

# --- Alignment ---
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: AcrossEmptyLines
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: AcrossEmptyLines
AlignEscapedNewlines: Left
AlignOperands: true
PointerAlignment: Right

# --- Single-line / compact ---
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true

# --- Breaks ---
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: AfterColon

# --- Spaces ---
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceInEmptyBlock: false
SpacesInParentheses: false

# --- Other ---
AlwaysBreakAfterReturnType: None
InsertBraces: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
ReflowComments: false
