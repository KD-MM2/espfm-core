menu "ESPFanManager Configuration"
    config ESPFM_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
    config ESPFM_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
    config ESPFM_AP_PASSWORD
        string "WiFi AP password (min 8 chars for WPA2)"
        default "espfm123"
    config ESPFM_WIFI_MAX_RETRY
        int "Maximum WiFi retry attempts"
        default 5
        range 1 20
    config ESPFM_OVERTEMP_THRESHOLD_C
        int "Over-temperature alarm threshold (deg C)"
        default 85
        range 50 150
    config ESPFM_CONTROL_PERIOD_MS
        int "Control loop period (ms)"
        default 1000
        range 100 10000
    config ESPFM_DS18B20_GPIO
        int "DS18B20 1-Wire GPIO pin (-1 to disable)"
        default -1
        range -1 48
        help
            GPIO pin for DS18B20 1-Wire bus. Set to -1 to disable DS18B20 support.
endmenu
